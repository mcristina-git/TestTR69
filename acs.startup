#!/bin/bash
ACS_MGMT_CIDR="${ACS_MGMT_CIDR:-10.0.100.1/24}"
ACS_CPE_CIDR="${ACS_CPE_CIDR:-10.0.111.254/24}"
MONGO_HOST="${MONGO_HOST:-10.0.100.2}"
JWT_SECRET="${GENIEACS_JWT_SECRET:-change_me_tr069_lab_jwt_secret}"

ip addr add "${ACS_MGMT_CIDR}" dev eth0
ip addr add "${ACS_CPE_CIDR}" dev eth1

sleep 3

mkdir -p /opt/genieacs
cat << CONF > /opt/genieacs/genieacs.env
GENIEACS_JWT_SECRET=${JWT_SECRET}
GENIEACS_UI_JWT_SECRET=${JWT_SECRET}
GENIEACS_MONGODB_CONNECTION_URL=mongodb://${MONGO_HOST}:27017/genieacs
GENIEACS_CWMP_INTERFACE=0.0.0.0
GENIEACS_CWMP_PORT=7557
GENIEACS_NBI_INTERFACE=0.0.0.0
GENIEACS_NBI_PORT=7547
GENIEACS_UI_INTERFACE=0.0.0.0
GENIEACS_UI_PORT=3000
CONF

set -a
. /opt/genieacs/genieacs.env
set +a

genieacs-cwmp > /tmp/genieacs-cwmp.log 2>&1 &
genieacs-nbi > /tmp/genieacs-nbi.log 2>&1 &
genieacs-ui > /tmp/genieacs-ui.log 2>&1 &
